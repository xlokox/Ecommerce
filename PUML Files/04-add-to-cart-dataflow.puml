@startuml Add to Cart Data Flow
!theme plain
skinparam backgroundColor #f8f9fa

title Data Flow: הוספת מוצר לעגלה (Add to Cart)

!define ENTITY rectangle
!define PROCESS circle
!define DATASTORE database

ENTITY "משתמש\n(User)" as User
PROCESS "1.0\nאימות בקשה\n(Validate Request)" as P1
PROCESS "2.0\nבדיקת מלאי\n(Check Stock)" as P2
PROCESS "3.0\nניהול עגלה\n(Manage Cart)" as P3
PROCESS "4.0\nעדכון מונה\n(Update Counter)" as P4
DATASTORE "D1\nמוצרים\n(Products DB)" as ProductsDB
DATASTORE "D2\nעגלות קניות\n(Carts DB)" as CartsDB
DATASTORE "D3\nלוג פעילות\n(Activity Log)" as ActivityLog

' Data flows with labels
User -> P1 : "בקשת הוספה\n(Add Request)\n{product_id, quantity, user_id}"

P1 -> P2 : "נתונים מאומתים\n(Validated Data)\n{product_id, quantity}"

P2 -> ProductsDB : "שאילתת מלאי\n(Stock Query)\n{product_id}"
ProductsDB -> P2 : "מידע מלאי\n(Stock Info)\n{stock_quantity, price, status}"

P2 -> P3 : "אישור זמינות\n(Availability Confirmation)\n{product_data, requested_quantity}"

P3 -> CartsDB : "שאילתת עגלה\n(Cart Query)\n{user_id, product_id}"
CartsDB -> P3 : "פריט קיים\n(Existing Item)\n{current_quantity} או null"

P3 -> CartsDB : "עדכון עגלה\n(Cart Update)\n{user_id, product_id, new_quantity, timestamp}"
CartsDB -> P3 : "אישור עדכון\n(Update Confirmation)\n{success, cart_item_id}"

P3 -> P4 : "בקשת עדכון מונה\n(Counter Update Request)\n{user_id}"

P4 -> CartsDB : "ספירת פריטים\n(Count Items)\n{user_id}"
CartsDB -> P4 : "מספר פריטים\n(Items Count)\n{total_items, total_quantity}"

P1 -> ActivityLog : "לוג פעילות\n(Activity Log)\n{user_id, action: 'add_to_cart', product_id, timestamp}"
P2 -> ActivityLog : "לוג בדיקת מלאי\n(Stock Check Log)\n{product_id, requested_qty, available_qty, timestamp}"
P3 -> ActivityLog : "לוג עדכון עגלה\n(Cart Update Log)\n{user_id, product_id, action, timestamp}"

P4 -> User : "תוצאת הוספה\n(Add Result)\n{success, message, cart_count, item_total}"

note right of CartsDB
  **מבנה עגלת קניות:**
  - _id: ObjectId
  - user_id: ObjectId
  - product_id: ObjectId
  - quantity: Number
  - price_at_time: Number
  - added_at: Date
  - updated_at: Date
end note

note right of ActivityLog
  **מבנה לוג פעילות:**
  - _id: ObjectId
  - user_id: ObjectId
  - action: String
  - product_id: ObjectId
  - details: Object
  - timestamp: Date
  - ip_address: String
end note

@enduml

@startuml Browse Products Data Flow
!theme plain
skinparam backgroundColor #f8f9fa

title Data Flow: דפדוף במוצרים (Browse Products)

!define ENTITY rectangle
!define PROCESS circle
!define DATASTORE database

ENTITY "משתמש\n(User)" as User
PROCESS "1.0\nטעינת מוצרים\n(Load Products)" as P1
PROCESS "2.0\nסינון מוצרים\n(Filter Products)" as P2
PROCESS "3.0\nחיפוש מוצרים\n(Search Products)" as P3
PROCESS "4.0\nמיון תוצאות\n(Sort Results)" as P4
PROCESS "5.0\nעיבוד תצוגה\n(Process Display)" as P5
DATASTORE "D1\nמוצרים\n(Products DB)" as ProductsDB
DATASTORE "D2\nקטגוריות\n(Categories DB)" as CategoriesDB
DATASTORE "D3\nלוג חיפושים\n(Search Log)" as SearchLog

' Data flows with labels
User -> P1 : "בקשת צפייה\n(View Request)\n{page, limit}"

P1 -> ProductsDB : "שאילתת מוצרים\n(Products Query)\n{status: 'active', limit, skip}"
ProductsDB -> P1 : "רשימת מוצרים\n(Products List)\n{products[], total_count}"

P1 -> CategoriesDB : "שאילתת קטגוריות\n(Categories Query)\n{active: true}"
CategoriesDB -> P1 : "רשימת קטגוריות\n(Categories List)\n{categories[]}"

User -> P2 : "קריטריוני סינון\n(Filter Criteria)\n{category, price_range, brand}"

P2 -> ProductsDB : "שאילתה מסוננת\n(Filtered Query)\n{category, price: {$gte, $lte}, brand}"
ProductsDB -> P2 : "מוצרים מסוננים\n(Filtered Products)\n{filtered_products[]}"

User -> P3 : "מילות חיפוש\n(Search Terms)\n{keyword, search_type}"

P3 -> ProductsDB : "חיפוש טקסט\n(Text Search)\n{$text: {$search: keyword}}"
ProductsDB -> P3 : "תוצאות חיפוש\n(Search Results)\n{matching_products[], relevance_score}"

P3 -> SearchLog : "לוג חיפוש\n(Search Log)\n{user_id, keyword, timestamp, results_count}"

P1 -> P4 : "מוצרים לא ממוינים\n(Unsorted Products)\n{products[]}"
P2 -> P4 : "מוצרים מסוננים\n(Filtered Products)\n{filtered_products[]}"
P3 -> P4 : "תוצאות חיפוש\n(Search Results)\n{search_results[]}"

User -> P4 : "קריטריוני מיון\n(Sort Criteria)\n{sort_by: price|name|rating, order: asc|desc}"

P4 -> P5 : "מוצרים ממוינים\n(Sorted Products)\n{sorted_products[]}"

P5 -> User : "תצוגה מעובדת\n(Processed Display)\n{products_display[], pagination, filters_applied}"

note right of ProductsDB
  **מבנה מוצר:**
  - _id: ObjectId
  - name: String
  - description: String
  - price: Number
  - category: String
  - images: Array[String]
  - rating: Number
  - stock: Number
  - status: String
end note

note right of SearchLog
  **מבנה לוג חיפוש:**
  - _id: ObjectId
  - user_id: String
  - keyword: String
  - timestamp: Date
  - results_count: Number
  - ip_address: String
end note

@enduml

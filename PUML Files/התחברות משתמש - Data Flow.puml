@startuml התחברות משתמש - Data Flow
!theme plain
skinparam backgroundColor #f8f9fa

title Data Flow: התחברות משתמש (User Login)

!define ENTITY rectangle
!define PROCESS circle
!define DATASTORE database

' Clean layout to avoid crossing lines
ENTITY "משתמש\n(User)" as User

PROCESS "1.0\nאימות נתונים\n(Validate Input)" as P1
PROCESS "2.0\nחיפוש משתמש\n(Find User)" as P2
PROCESS "3.0\nאימות סיסמה\n(Verify Password)" as P3
PROCESS "4.0\nיצירת Token\n(Generate Token)" as P4
PROCESS "5.0\nעדכון התחברות\n(Update Login)" as P5

DATASTORE "D1\nמשתמשים\n(Users DB)" as UsersDB
DATASTORE "D2\nסשנים\n(Sessions DB)" as SessionsDB
DATASTORE "D3\nלוג מערכת\n(System Log)" as SystemLog

' Main linear flow
User --> P1 : "פרטי התחברות"
P1 --> P2 : "נתונים מאומתים"
P2 --> P3 : "נתונים לאימות"
P3 --> P4 : "משתמש מאומת"
P4 --> P5 : "פרטי Token"
P5 --> User : "תוצאת התחברות"

' Database interactions - positioned to avoid crossing
P2 --> UsersDB : "חיפוש משתמש"
P5 --> UsersDB : "עדכון התחברות"
P5 --> SessionsDB : "שמירת סשן"

' Logging flows - positioned at bottom
P1 --> SystemLog : "לוג ניסיון"
P3 --> SystemLog : "לוג אימות"
P4 --> SystemLog : "לוג Token"

note bottom of UsersDB
  **מבנה נתונים:**
  - _id: ObjectId
  - email: String (unique)
  - password: String (hashed)
  - role: String
  - last_login: Date
end note

note bottom of SessionsDB
  **מבנה סשן:**
  - _id: ObjectId
  - user_id: ObjectId
  - token: String
  - expires_at: Date
end note

@enduml
